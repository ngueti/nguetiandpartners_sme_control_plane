# Base Neon (chaîne poolée) — obligatoire
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Secret de signature des sessions admin et de hachage des IP — 32 caractères minimum (openssl rand -hex 32)
SESSION_SECRET=
# URL publique du site (liens dans les e-mails)
SITE_URL=https://votre-domaine.com

# Resend (e-mails automatiques : accusés de réception + alertes équipe pays)
RESEND_API_KEY=
MAIL_FROM="Ngueti & Partners <no-reply@votre-domaine-verifie.com>"
TEAM_EMAIL_CM=
TEAM_EMAIL_CI=
TEAM_EMAIL_BJ=
TEAM_EMAIL_DEFAULT=

# Synchronisations optionnelles
LINEAR_API_KEY=
LINEAR_TEAM_ID=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Vercel Cron (nettoyage des fichiers orphelins) — Vercel l'envoie automatiquement en Bearer
CRON_SECRET=
